# Wzór zmiennych środowiskowych — skopiuj do .env.local i uzupełnij.
# Lokalnie zawsze klucze DEV. Klucze PROD tylko w Vercel (środowisko Production).

# Stripe (lokalnie/preview: klucz testowy sk_test_...)
STRIPE_SECRET_KEY=
# Sekret webhooka (whsec_...): lokalnie z `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# produkcja: Dashboard → Developers → Webhooks → endpoint https://kompetencje.ai/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Domena aplikacji (bez ukośnika na końcu), lokalnie http://localhost:3000
DOMAIN=

# Supabase: Project Settings → API (URL projektu + Secret key (sb_secret_...), NIE Publishable)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
